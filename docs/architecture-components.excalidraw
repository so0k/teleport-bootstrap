      "height": 25,
      "text": "DataDog Agent",
      "fontSize": 20,
      "strokeColor": "#991b1b",
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "datadog_box"
    },
    {
      "type": "text",
      "id": "datadog_detail",
      "x": 355,
      "y": 605,
      "width": 190,
      "height": 90,
      "text": "journald logs\nOpenMetrics\n:3000/metrics",
      "fontSize": 15,
      "strokeColor": "#1e1e1e",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },

    {
