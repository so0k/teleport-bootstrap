{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "type": "text",
      "id": "title",
      "x": 180,
      "y": 0,
      "width": 500,
      "height": 35,
      "text": "EC2 Teleport Agent — Runtime Components",
      "fontSize": 28,
      "strokeColor": "#1e1e1e",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },

    {
      "type": "rectangle",
      "id": "ec2_zone",
      "x": 50,
      "y": 60,
      "width": 820,
      "height": 680,
      "backgroundColor": "#d3f9d8",
      "fillStyle": "solid",
      "roundness": { "type": 3 },
      "strokeColor": "#22c55e",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "opacity": 25
    },
    {
      "type": "text",
      "id": "ec2_label",
      "x": 70,
      "y": 70,
      "width": 350,
      "height": 28,
      "text": "EC2 Instance (Packer AMI)",
      "fontSize": 22,
      "strokeColor": "#15803d",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },

    {
      "type": "rectangle",
      "id": "cloudinit_box",
      "x": 80,
      "y": 110,
      "width": 760,
      "height": 200,
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "roundness": { "type": 3 },
      "strokeColor": "#4a9eed",
      "strokeWidth": 2,
      "opacity": 60
    },
    {
      "type": "text",
      "id": "cloudinit_header",
      "x": 100,
      "y": 120,
      "width": 350,
      "height": 25,
      "text": "cloud-init (runs once at boot)",
      "fontSize": 20,
      "strokeColor": "#2563eb",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "cloudinit_steps",
      "x": 100,
      "y": 155,
      "width": 720,
      "height": 140,
      "text": "1. Fetch AWS region from IMDSv2\n2. /opt/teleport/scripts/init-datadog.sh (API key from SM)\n3. /home/teleport/init.sh (enable systemd watcher)\n4. /home/confd/init.sh -p {name_prefix} (start confd)\n5. systemctl restart datadog-agent\n6. Run bootstrap_commands (optional, e.g. download CA certs)",
      "fontSize": 16,
      "strokeColor": "#1e1e1e",
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },

    {
      "type": "rectangle",
      "id": "confd_box",
      "x": 80,
      "y": 340,
      "width": 200,
      "height": 180,
      "backgroundColor": "#ffd8a8",
      "fillStyle": "solid",
      "roundness": { "type": 3 },
      "strokeColor": "#f59e0b",
      "strokeWidth": 2
    },
    {
      "type": "text",
      "id": "confd_header",
      "x": 140,
      "y": 350,
      "width": 80,
      "height": 25,
      "text": "confd",
      "fontSize": 20,
      "strokeColor": "#92400e",
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "confd_box"
    },
    {
      "type": "text",
      "id": "confd_detail",
      "x": 95,
      "y": 385,
      "width": 170,
      "height": 120,
      "text": "Polls SSM\nevery 60s\n\nRenders config\nto filesystem",
      "fontSize": 15,
      "strokeColor": "#1e1e1e",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },

    {
      "type": "rectangle",
      "id": "systemd_box",
      "x": 340,
      "y": 340,
      "width": 220,
      "height": 180,
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "roundness": { "type": 3 },
      "strokeColor": "#7c3aed",
      "strokeWidth": 2
    },
    {
      "type": "text",
      "id": "systemd_header",
      "x": 380,
      "y": 350,
      "width": 140,
      "height": 25,
      "text": "systemd watcher",
      "fontSize": 20,
      "strokeColor": "#5b21b6",
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "systemd_box"
    },
    {
      "type": "text",
      "id": "systemd_detail",
      "x": 355,
      "y": 385,
      "width": 190,
      "height": 120,
      "text": ".path unit monitors\n/etc/teleport.yaml\n\n.service unit\nrestarts teleport",
      "fontSize": 15,
      "strokeColor": "#1e1e1e",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },

    {
      "type": "rectangle",
      "id": "teleport_box",
      "x": 620,
      "y": 340,
      "width": 220,
      "height": 180,
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "roundness": { "type": 3 },
      "strokeColor": "#5b21b6",
      "strokeWidth": 2
    },
    {
      "type": "text",
      "id": "teleport_header",
      "x": 660,
      "y": 350,
      "width": 140,
      "height": 25,
      "text": "Teleport Agent",
      "fontSize": 20,
      "strokeColor": "#5b21b6",
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "teleport_box"
    },
    {
      "type": "text",
      "id": "teleport_detail",
      "x": 635,
      "y": 385,
      "width": 190,
      "height": 120,
      "text": "SSH service\nDB service\nApp service\nDiscovery svc\n\nIAM join method",
      "fontSize": 15,
      "strokeColor": "#1e1e1e",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },

    {
      "type": "arrow",
      "id": "a_confd_systemd",
      "x": 280,
      "y": 430,
      "width": 60,
      "height": 0,
      "points": [[0, 0], [60, 0]],
      "endArrowhead": "arrow",
      "strokeWidth": 2,
      "strokeColor": "#7c3aed",
      "startBinding": { "elementId": "confd_box", "fixedPoint": [1, 0.5] },
      "endBinding": { "elementId": "systemd_box", "fixedPoint": [0, 0.5] }
    },
    {
      "type": "arrow",
      "id": "a_systemd_teleport",
      "x": 560,
      "y": 430,
      "width": 60,
      "height": 0,
      "points": [[0, 0], [60, 0]],
      "endArrowhead": "arrow",
      "strokeWidth": 2,
      "strokeColor": "#5b21b6",
      "startBinding": { "elementId": "systemd_box", "fixedPoint": [1, 0.5] },
      "endBinding": { "elementId": "teleport_box", "fixedPoint": [0, 0.5] }
    },

    {
      "type": "rectangle",
      "id": "datadog_box",
      "x": 340,
