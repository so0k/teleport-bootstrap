      "x": 100,
      "y": 850,
      "width": 350,
      "height": 115,
      "text": "Key: /{name_prefix}/teleport-etc/contents\nValue: Full teleport.yaml (YAML)\n\nWritten by Terraform\nRead by confd on each instance",
      "fontSize": 15,
      "strokeColor": "#1e1e1e",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },

    {
      "type": "arrow",
